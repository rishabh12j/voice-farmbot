# ROS2 build artefacts
/build/
/install/
/log/

# Compiled Python
*.pyc
__pycache__/
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# GrowMate runtime data — do not commit (lives in ~/.growmate_voice/)
*.log
history.jsonl
demo_recordings/

# Local scratch
tools/_*.yaml
tools/_*.csv
tools/_*.py

# Personal / academic artefacts — do not commit (working thesis files live in
# documentation/ but only the .md notes belong in git)
demo/Interim_Report_*.pdf
*.pdf
*.pptx
documentation/*.docx
documentation/*.xlsx
documentation/*.zip

# Agent scratch dirs
.codex-tmp/

# Virtual environments
venv/
venv-*/
.venv/

# Curl-downloaded API docs (regenerate with build_docs script)
src/growmate_voice/intent_server_docs*.html
src/growmate_voice/intent_server_openapi.json

# Loose root data files (real maps live in tools/maps/)
/map.yaml
/a.yaml
tools/active_map.yaml
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
